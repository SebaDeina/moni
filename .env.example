# Copiar a .env y completar. Nunca subir .env al repo.

PORT=3000
# En el VPS, puerto local donde Docker expone la app (Caddy apunta acá)
HOST_PORT=3000

# WhatsApp: kapso | baileys
WHATSAPP_PROVIDER=kapso
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=

# LLM (API compatible con OpenAI; por defecto xAI)
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7

# Transcripción de audios
TRANSCRIBE_API_KEY=

# Avalanche Fuji. Wallet descartable, solo AVAX de prueba.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
WALLET_PRIVATE_KEY=
AVALANCHE_DATA_API_KEY=
