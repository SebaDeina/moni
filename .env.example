# Copiar a .env y completar. Nunca subir .env al repo.

PORT=3000
# En el VPS, puerto local donde Docker expone la app (Caddy apunta acá)
HOST_PORT=3000

# WhatsApp: kapso | baileys
WHATSAPP_PROVIDER=kapso
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_WEBHOOK_SECRET=
# Números habilitados, separados por coma (vacío = cualquiera)
ALLOWED_SENDERS=

# Claude (Anthropic). La clave sale de console.anthropic.com
ANTHROPIC_API_KEY=
MONI_CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high | xhigh | max
MONI_CLAUDE_EFFORT=low

# Transcripción de audios cuando Kapso no la manda (clave de xAI). Vacío = Moni pide que escriban.
TRANSCRIBE_API_KEY=

# Número de WhatsApp de Moni para el botón de la landing (se muestra tal cual)
MONI_WHATSAPP_NUMBER=

# Agenda compartida: alias=dirección, separados por coma
CONTACTS=

# Avalanche Fuji. Wallet descartable, solo AVAX de prueba.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Tesorería: fondea las wallets nuevas de los usuarios
WALLET_PRIVATE_KEY=
# Clave maestra para cifrar las wallets de los usuarios: openssl rand -hex 32
MONI_WALLET_MASTER_KEY=
# AVAX de bienvenida que recibe cada wallet nueva (el gas lo paga 0xGasless)
WELCOME_AVAX=0.05
# 0xGasless: clave del paymaster de Fuji. Sin ella no se puede enviar.
OXGASLESS_API_KEY=
AVALANCHE_DATA_API_KEY=
# Contrato MoniVault en Fuji (opcional: por defecto el desplegado, ver contracts/)
MONI_VAULT_ADDRESS=
